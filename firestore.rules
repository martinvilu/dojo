rules_version = '2';

// Ninja Dojo - Reglas de seguridad de Firestore (RBAC)
//
// El acceso directo del cliente se limita a los datos que la UI consume en
// tiempo real (foros Q&A, presentismo, encuestas anónimas). Toda operación
// privilegiada (roles, notas, roster, backups, auditoría) pasa por Cloud
// Functions vía el SDK admin, que no está sujeta a estas reglas.
//
// Modelo de membresía basado en IDs predecibles:
//   course_teachers/{courseId}_{uid}  -> docente asignado al curso
//   course_roster/{courseId}_{uid}    -> estudiante en el roster del curso
//   enrollments/{uid}_{courseId}      -> inscripción activa del estudiante
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data;
    }

    // Rol desde el custom claim del token (mejora 3.34): evita un get() del
    // perfil por evaluación. Si el token todavía no trae el claim, se usa
    // el perfil como respaldo.
    function myRole() {
      return request.auth.token.get('role', null) != null
        ? request.auth.token.role
        : myProfile().role;
    }

    function isAdmin() {
      return signedIn() && myRole() == 'admin';
    }

    function isTeacherRole() {
      return signedIn() && myRole() == 'teacher';
    }

    function isTeacherOf(courseId) {
      return signedIn()
        && exists(/databases/$(database)/documents/course_teachers/$(courseId + '_' + request.auth.uid));
    }

    function isEnrolledIn(courseId) {
      return signedIn()
        && (exists(/databases/$(database)/documents/course_roster/$(courseId + '_' + request.auth.uid))
            || exists(/databases/$(database)/documents/enrollments/$(request.auth.uid + '_' + courseId)));
    }

    function isMemberOf(courseId) {
      return isAdmin() || isTeacherOf(courseId) || isEnrolledIn(courseId);
    }

    // ------------------------------------------------------------------
    // Perfiles: cada usuario solo lee su propio perfil. Los perfiles se
    // aprovisionan desde el backend (acción getProfile). Los docentes y
    // admins únicamente pueden editar el mapa 'commissions' y solo sobre
    // perfiles de estudiantes.
    // ------------------------------------------------------------------
    match /profiles/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      // Las comisiones se asignan con la acción setStudentCommission, que
      // verifica que el docente pertenezca al curso.
      allow create, update, list, delete: if false;
    }

    // ------------------------------------------------------------------
    // Cursos: el documento raíz y sus metadatos se gestionan por backend.
    match /courses/{courseId} {
      allow read, write: if false;

      // Presentismo: los miembros consultan; solo el docente del curso
      // registra o corrige planillas de asistencia.
      match /attendance/{attendanceId} {
        allow read: if isMemberOf(courseId);
        allow create, update: if isTeacherOf(courseId)
          && request.resource.data.keys().hasOnly(['records', 'updated_at', 'classNumber', 'updated_by'])
          && request.resource.data.records is map
          && request.resource.data.records.size() <= 2000;
        allow delete: if false;
      }

      // Sesión de QR vigente: la crea el backend (startQrAttendance) con un
      // secreto por sesión. Ningún cliente la lee ni la escribe: el docente
      // recibe el secreto como respuesta y los estudiantes validan el código
      // vía submitQrAttendance.
      match /active_qr/{qrId} {
        allow read, write: if false;
      }

      // Foro Q&A por clase: miembros leen y publican consultas. En updates,
      // un participante solo puede mutar reacciones; el docente del curso o
      // un admin solo pueden alternar la marca de mejor respuesta.
      match /class_comments/{commentId} {
        function onlyReactionsChanged() {
          // Base fields must never change, and beyond that only the
          // 'reactions' subtree may differ: either the map already existed
          // (no new top-level keys) or it is being added wholesale on a
          // legacy comment (affected key path is exactly 'reactions').
          return request.resource.data.diff(resource.data)
                 .unchangedKeys().hasAll(['classNumber', 'user_id', 'content', 'created_at'])
            && (request.resource.data.keys().hasOnly(resource.data.keys())
              || request.resource.data.diff(resource.data)
                   .affectedKeys().hasOnly(['reactions']));
        }
        function onlyBestAnswerChanged() {
          return request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['is_best_answer']);
        }
        // El autor puede corregir el texto de su propio mensaje (mejora
        // 3.14); queda marcado con edited_at = hora del servidor.
        function onlyOwnContentEdited() {
          return resource.data.user_id == request.auth.uid
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['content', 'edited_at'])
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && request.resource.data.content.size() <= 4000
            && request.resource.data.edited_at == request.time;
        }

        allow read: if isMemberOf(courseId);
        // El rol mostrado junto al nombre es el del perfil: un estudiante
        // no puede firmar como docente.
        allow create: if isMemberOf(courseId)
          && request.resource.data.keys().hasOnly(['classNumber', 'user_id', 'user_name', 'user_role', 'content', 'reactions', 'created_at'])
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.get('user_role', myRole()) == myRole()
          && request.resource.data.get('user_name', '') is string
          && request.resource.data.get('user_name', '').size() <= 120
          && request.resource.data.classNumber is int
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 4000;
        allow update: if ((isAdmin() || isTeacherOf(courseId)) && onlyBestAnswerChanged())
          || (isMemberOf(courseId) && onlyReactionsChanged())
          || (isMemberOf(courseId) && onlyOwnContentEdited());
        // El autor borra sus mensajes; el equipo docente modera cualquiera.
        allow delete: if (isMemberOf(courseId) && resource.data.user_id == request.auth.uid)
          || isAdmin() || isTeacherOf(courseId);
      }

      // Encuestas anónimas por clase: el id del documento es el hash del
      // uid + clase (no adivinable), por lo que el estudiante puede leer y
      // escribir su propia respuesta. El docente agrega resultados por clase.
      match /class_feedback/{feedbackId} {
        allow get, list: if isMemberOf(courseId);
        allow create, update: if isEnrolledIn(courseId)
          && request.resource.data.keys().hasOnly(['classNumber', 'rating', 'understanding', 'comment', 'created_at'])
          && request.resource.data.classNumber is int
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.get('understanding', '') is string
          && request.resource.data.get('understanding', '').size() <= 100
          && request.resource.data.get('comment', '') is string
          && request.resource.data.get('comment', '').size() <= 2000;
        allow delete: if false;
      }
    }

    // ------------------------------------------------------------------
    // Entregas: sin acceso directo del cliente. La lectura se realiza con
    // getAssignmentSubmissions / getStudentAssignments (backend).
    match /submissions/{submissionId} {
      allow get: if signedIn() && resource.data.student_id == request.auth.uid;
      allow list, create, update, delete: if false;
    }

    // Bitácora inmutable de calificaciones: consulta para docentes y admins.
    // Las escrituras provienen exclusivamente del backend.
    match /audit_logs/{logId} {
      allow read: if isAdmin() || isTeacherRole();
      allow write: if false;
    }

    // Logs de actividad: escritura y lectura solo por backend.
    match /activity_logs/{logId} {
      allow read, write: if false;
    }

    // ------------------------------------------------------------------
    // Denegación explícita para todo lo demás: perfiles ajenos, cursos,
    // inscripciones, rosters, docentes asignados, clases, avisos,
    // notificaciones, grupos de estudio, tutorías, cronogramas versionados,
    // backups, plantillas de correo y configuración global se consumen
    // exclusivamente a través de Cloud Functions.
    // ------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

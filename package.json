{
  "name": "ninja-dojo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/unit/*.test.ts",
    "test:selenium": "node tests/selenium/run-all-tests.js",
    "test:rules": "npx -y firebase-tools@latest emulators:exec --only firestore --project demo-ninja-dojo-rules -- \"npx jest tests/firestore.rules.test.js --runInBand\"",
    "test:local": "./scripts/test-local.sh"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "html5-qrcode": "^2.3.8",
    "marked": "^18.0.5",
    "next": "16.3.8",
    "nextjs-toast-notify": "^1.62.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/selenium-webdriver": "^4.35.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jest": "^30.4.2",
    "selenium-webdriver": "^4.46.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "protobufjs": "^7.6.5",
    "@fastify/busboy": "^3.2.3",
    "@grpc/grpc-js": "^1.14.6",
    "sharp": "^0.35.5",
    "source-map-js": "^1.2.2",
    "minimatch@3": {
      "brace-expansion": "^1.1.21"
    },
    "minimatch@9": {
      "brace-expansion": "^2.1.7"
    },
    "minimatch@10": {
      "brace-expansion": "^5.0.12"
    }
  }
}
